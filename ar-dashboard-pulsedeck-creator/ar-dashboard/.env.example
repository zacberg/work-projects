# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
#
# ── Salesforce (sandbox) — authorization-code flow ──
# Connected App client id/secret. Run `python sf_auth.py` once to log in via the
# browser; it writes SF_REFRESH_TOKEN below (no SF admin "Run As" user needed).
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
SF_INSTANCE_URL=https://advantive--full.sandbox.my.salesforce.com
SF_BASE_URL=https://advantive--full.sandbox.my.salesforce.com
# Written automatically by sf_auth.py after the one-time browser login:
SF_REFRESH_TOKEN=

# ── NetSuite (sandbox) — Token-Based Auth (OAuth 1.0a) ──
NS_ACCOUNT_ID=8151367_SB1
NS_CONSUMER_KEY=your_ns_consumer_key
NS_CONSUMER_SECRET=your_ns_consumer_secret
NS_TOKEN_ID=your_ns_token_id
NS_TOKEN_SECRET=your_ns_token_secret

# ── Optional ──
# Path to the weekly AR Tracker workbook used by the Pulse Deck builder.
# PULSE_AR_TRACKER=C:/Users/you/Downloads/2026 Advantive AR Tracker.xlsx
